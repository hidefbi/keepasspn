<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

    <TextView
        android:id="@+id/node_actions_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView
            android:id="@+id/node_actions_edit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:text="@string/menu_edit" />
        <TextView
            android:id="@+id/node_actions_duplicate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:text="@string/menu_copy" />
        <TextView
            android:id="@+id/node_actions_move"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:text="@string/menu_move" />
        <TextView
            android:id="@+id/node_actions_move_up"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:text="@string/group_move_up" />
        <TextView
            android:id="@+id/node_actions_move_down"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:text="@string/group_move_down" />
        <TextView
            android:id="@+id/node_actions_restore"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:text="@string/menu_restore" />
        <TextView
            android:id="@+id/node_actions_delete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="#D32F2F"
            android:text="@string/menu_delete" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
