<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/pgp_generate_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pgp_user_id_hint"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/pgp_generate_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pgp_passphrase_hint"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/pgp_generate_passphrase_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pgp_passphrase_repeat_hint"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pgp_passphrase_notice"
            style="@style/KeePassPNStyle.Text.Tiny" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pgp_key_type_title"
            style="@style/KeePassPNStyle.Text" />

        <RadioGroup
            android:id="@+id/pgp_generate_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/pgp_generate_type_curve25519"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/pgp_key_type_curve25519" />

            <RadioButton
                android:id="@+id/pgp_generate_type_rsa3072"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pgp_key_type_rsa3072" />

            <RadioButton
                android:id="@+id/pgp_generate_type_rsa4096"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pgp_key_type_rsa4096" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
